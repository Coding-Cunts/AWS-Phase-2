# ==============================================================================
# TERRA Unified Application — Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Gemini Vision AI Keys
# ------------------------------------------------------------------------------
# Primary Gemini API key (from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_primary_gemini_api_key_here

# Automatic failover key for quota cooldown / rate-limit resilience
GEMINI_API_KEY_BACKUP=your_backup_gemini_api_key_here

# Optional: Comma-separated pool of multiple Gemini API keys
# GEMINI_API_KEYS=key1,key2,key3

# Vision model identifier (recommended: gemini-3.7-flash or gemini-3.5-flash)
GEMINI_MODEL=gemini-3.7-flash

# Optional: Thinking level for Gemini 3 models ('low' | 'default' | 'high')
GEMINI_THINKING=low

# Optional: Scan mode ('thorough' | 'fast')
GEMINI_SCAN_MODE=thorough

# ------------------------------------------------------------------------------
# Backend & API Security
# ------------------------------------------------------------------------------
# Operator secret required to remotely create/list/revoke API keys via x-admin-key header
# (Requests from localhost/127.0.0.1 are permitted without this secret during local development)
ECO_ADMIN_SECRET=your_secure_operator_secret_here

# Backend Express server port
PORT=3001

# ------------------------------------------------------------------------------
# Frontend & Proxy Integration
# ------------------------------------------------------------------------------
# Backend target URL for Next.js API rewrites and server-side proxy calls
BACKEND_URL=http://127.0.0.1:3001

# Frontend application public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
