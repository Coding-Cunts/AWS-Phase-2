# ==============================================================================
# TERRA Platform Environment Configuration
# ==============================================================================

# Google Gemini API Keys (Free Tier Multimodal Vision)
# You can provide multiple keys. If one key hits its rate/quota limit (HTTP 429),
# the system automatically rotates to the next available key in the pool.

# Option 1: Comma-separated list of keys (Recommended for multi-key failover):
# GEMINI_API_KEYS=AIzaSyA_key1,AIzaSyB_key2,AIzaSyC_key3

# Option 2: Single default key:
# GEMINI_API_KEY=AIzaSy...

# Option 3: Numbered individual keys:
# GEMINI_API_KEY_1=AIzaSy...
# GEMINI_API_KEY_2=AIzaSy...
# GEMINI_API_KEY_3=AIzaSy...

# Optional Model Override (Defaults to gemini-3.8-flash):
# GEMINI_MODEL=gemini-3.8-flash

